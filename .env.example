# Option [development, deployment]
ENVIRONMENT="development"

# Vector DB
# Option [qdrant, elastic]
VECTOR_DB_PROVIDER="qdrant"
VECTOR_DB_API_KEY="EMPTY"
VECTOR_DB_URL="http://localhost:6333"

# Embedding Model Configuration
# Option [ollama, openai, fastembed, huggingface]
EMBED_MODEL_PROVIDER="ollama"
EMBED_MODEL_NAME="bge-m3"
EMBED_MODEL_BASE="http://localhost:11434"
EMBED_DIMENSION="1024"
EMBED_MODEL_API_KEY="EMPTY"

# LLM Configuration
# Option [deepseek, custom, openai, ollama]
LLM_PROVIDER="custom"
LLM_API_KEY="EMPTY"
LLM_API_BASE="http://localhost:11434/v1"
LLM_MODEL="qwen2.5:32b"
LLM_TEMPERATURE="0.0"

# LLM Trace 
LANGFUSE_ENABLE="false"
LANGFUSE_PUBLIC_KEY="pk-lf-......"
LANGFUSE_SECRET_KEY="sk-lf-......"
LANGFUSE_HOST="http://localhost:3000"

# Parser
PARSER_TYPE="marker"
PARSER_URL="http://localhost:8008"

# Retrieval
ENABLE_QUERY_PREPROCESS="false"
NUM_QUERIES="3"
DENSE_TOP_K="5"
SPARSE_TOP_K="5"
FUSE_TOP_K="5"
REPACK_STRATEGY="forward" # Option [forward, reverse, side]

# Others
CHAT_MODE="False"
API_PORT="8008"
MCP_PORT="8009"